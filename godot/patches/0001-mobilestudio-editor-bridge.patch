+JNIEXPORT void JNICALL Java_org_godotengine_godot_editor_utils_EditorUtils_mobileStudioSelectMainScreen(JNIEnv *p_env, jclass, jint p_index) {
+#ifdef TOOLS_ENABLED
+	EditorNode *editor_node = EditorNode::get_singleton();
+	if (editor_node == nullptr) {
+		return;
+	}
+	EditorMainScreen *main_screen = editor_node->get_editor_main_screen();
+	if (main_screen == nullptr) {
+		return;
+	}
+	if (p_index < EditorMainScreen::EDITOR_2D || p_index > EditorMainScreen::EDITOR_ASSETLIB) {
+		return;
+	}
+	main_screen->select(p_index);
+#endif
+}
+
+JNIEXPORT void JNICALL Java_org_godotengine_godot_editor_utils_EditorUtils_mobileStudioFocusDock(JNIEnv *p_env, jclass, jstring p_dock) {
+#ifdef TOOLS_ENABLED
+	String dock_key = jstring_to_string(p_dock, p_env);
+	if (dock_key == "script") {
+		EditorNode *editor_node = EditorNode::get_singleton();
+		if (editor_node != nullptr && editor_node->get_editor_main_screen() != nullptr) {
+			editor_node->get_editor_main_screen()->select(EditorMainScreen::EDITOR_SCRIPT);
+		}
+		return;
+	}
+
+	EditorDock *dock = nullptr;
+	if (dock_key == "scene") {
+		dock = SceneTreeDock::get_singleton();
+	} else if (dock_key == "inspector") {
+		dock = InspectorDock::get_singleton();
+	} else if (dock_key == "files" || dock_key == "filesystem") {
+		dock = FileSystemDock::get_singleton();
+	}
+
+	EditorDockManager *dock_manager = EditorDockManager::get_singleton();
+	if (dock != nullptr && dock_manager != nullptr) {
+		dock_manager->focus_dock(dock);
+	}
+#endif
+}
+
+JNIEXPORT void JNICALL Java_org_godotengine_godot_editor_utils_EditorUtils_mobileStudioApplyMobileLayout(JNIEnv *p_env, jclass) {
+#ifdef TOOLS_ENABLED
+	EditorDockManager *dock_manager = EditorDockManager::get_singleton();
+	if (dock_manager == nullptr) {
+		return;
+	}
+
+	Vector<String> dock_names;
+	for (EditorDock *dock : dock_manager->get_all_docks()) {
+		if (dock != nullptr) {
+			dock_names.push_back(dock->get_effective_layout_key());
+		}
+	}
+
+	if (!dock_names.is_empty()) {
+		Ref<ConfigFile> layout;
+		layout.instantiate();
+		layout->set_value("docks", "dock_10", String(",").join(dock_names));
+		layout->set_value("docks", "dock_10_selected_tab_idx", 0);
+		dock_manager->load_docks_from_config(layout, "docks", false);
+	}
+
+	EditorSettings *editor_settings = EditorSettings::get_singleton();
+	if (editor_settings != nullptr) {
+		editor_settings->set_setting("interface/touchscreen/enable_touch_optimizations", true);
+		editor_settings->set_setting("interface/touchscreen/enable_long_press_as_right_click", true);
+		editor_settings->set_setting("interface/touchscreen/enable_pan_and_scale_gestures", true);
+	}
+
+	EditorNode *editor_node = EditorNode::get_singleton();
+	if (editor_node != nullptr && editor_node->get_editor_main_screen() != nullptr) {
+		editor_node->get_editor_main_screen()->select(EditorMainScreen::EDITOR_SCRIPT);
+	}
+#endif
+}
