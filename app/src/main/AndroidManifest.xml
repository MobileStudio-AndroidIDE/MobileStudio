<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <package android:name="org.godotengine.godot_gradle_build_environment" />
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MobileStudioApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileStudio"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:minWidth="320dp"
        android:minHeight="480dp">

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <activity
            android:name=".BuildBootActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProjectSettingsActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".extension.ExtensionManagerActivity" android:exported="false" android:theme="@style/Theme.MobileStudio" />
        <activity android:name=".extension.MyExtensionsActivity" android:exported="false" android:theme="@style/Theme.MobileStudio" />
        <activity android:name=".extension.AdminDashboardActivity" android:exported="false" android:theme="@style/Theme.MobileStudio" />
        <activity android:name=".codebrain.CodeBrainActivity" android:exported="false" android:theme="@style/Theme.MobileStudio" />

        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BuildToolsSettingsActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ToolchainFileExplorerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LayoutPreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <activity
            android:name=".XmlVisualEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <activity
            android:name=".ComposePreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <activity
            android:name=".web.HtmlPreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AndroidShellActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LogcatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".SupabaseCommunityActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="community-auth"
                    android:scheme="mobilestudio" />
            </intent-filter>
        </activity>

        <activity
            android:name=".extension.ExtAuthCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="ext-auth"
                    android:scheme="mobilestudio" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HtmlViewerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AppIconEditorActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ApkSigningActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ApkInfoActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".DiffViewerActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ai.ui.AiWorkspaceActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Win64ManagerActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ai.AiActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TaskManagerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GameRunnerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name="com.aide.mobilestudio.godot.MobileGodotEditorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/GodotEditorSplashScreenTheme" />

        <activity
            android:name="org.godotengine.editor.GodotEditor"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/GodotEditorSplashScreenTheme" />

        <activity
            android:name="org.godotengine.editor.GodotGame"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":GodotGame"
            android:taskAffinity=":game"
            android:autoRemoveFromRecents="true"
            android:supportsPictureInPicture="true"
            android:screenOrientation="userLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/GodotGameTheme" />

        <activity
            android:name="org.godotengine.editor.embed.EmbeddedGodotGame"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":EmbeddedGodotGame"
            android:taskAffinity=":embed"
            android:excludeFromRecents="true"
            android:supportsPictureInPicture="true"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/GodotEmbeddedGameTheme" />

        <activity
            android:name="org.godotengine.editor.GodotXRGame"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":GodotXRGame"
            android:taskAffinity=":xr"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />


        <service
            android:name=".GradleBuildService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ShellJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>

        <activity
            android:name=".asteros.AsterOSActivity"
            android:exported="false"
            android:label="AsterOS"
            android:theme="@style/Theme.MobileStudio.Inner"/>

        <receiver
            android:name=".PermissionActionReceiver"
            android:exported="false" />

    </application>
</manifest>
