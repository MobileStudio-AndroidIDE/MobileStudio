<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#ffffff">

    <TextView
        android:id="@+id/asteros_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AsterOS 대기 중 - 바이너리 파일을 선택하세요"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/asteros_file_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="파일을 선택하지 않았습니다"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/asteros_analyze_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Macho 분석 시작"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/asteros_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="분석 결과는 여기에 표시됩니다"
        android:textSize="14sp"
        android:textColor="#333333"
        android:background="#f0f0f0"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/asteros_log"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="로그:"
        android:textSize="12sp"
        android:textColor="#555555"
        android:background="#e0e0e0"
        android:padding="4dp"/>
</LinearLayout>